# Postgres (shared by microservice + trainer)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=surf_ai
POSTGRES_USER=surf_ai
POSTGRES_PASSWORD=change-me

# RabbitMQ (microservice only)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=surf
RABBITMQ_PASSWORD=change-me

# S3/MinIO (shared by microservice + trainer)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=surf-ai
S3_ACCESS_KEY=surfai
S3_SECRET_KEY=change-me

# Trainer sidecar URL, as seen by the microservice
TRAINER_BASE_URL=http://trainer:8000
